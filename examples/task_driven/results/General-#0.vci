config network hnocs.topologies.TaskMesh
config sim-time-limit 20ms
config record-eventlog false
config **.vector-recording true
config **.cmdenv-log-level error
config **.rows 4
config **.columns 4
config **.coreType "\"hnocs.cores.task.TaskPE\""
config **.routerType "\"hnocs.routers.hier.Router\""
config **.portType "\"hnocs.routers.hier.Port\""
