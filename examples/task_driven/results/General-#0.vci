config **.pe[*].powerSendPerFlit 2e-10J
config **.pe[*].powerRecvPerFlit 1e-10J
config **.pe[*].energyWindow 100ns
config **.pe[*].computeDensity 0
config **.inPort.flitsPerVC 4
config **.inPort.collectPerHopWait false
config **.inPort.energyWindow 100ns
config **.inPort.enableEnergyWindow true
config **.inPort.eBufferWrite 1e-12J
config **.inPort.eBufferRead 1e-12J
config **.inPort.eCrossbar 0.5e-12J
config **.inPort.pLeak 1e-3W
config **.sched.arbitration_type 0
config **.sched.freeRunningClk false
config **.heterogeneous false
config **.givenTclk false
config **.tClk 1ns
config **.RconvPE 8
config **.RconvRouter 10
config **.RlateralPE 10
config **.RlateralRouter 10
config **.Rpe2router 3
config **.Cpe 1e-6
config **.Crouter 1e-7
config **.Tambient 318.15
config **.Tthrottle 326.15
config **.throttleBeta 0.1
